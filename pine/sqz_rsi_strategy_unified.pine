//@version=5
// GENERADO por src/sqzlab/genpine.py desde params/{h4,d1,w1}.json. NO editar a mano. NO COMPILADO en TradingView.
// Version strategy() del indicador SQZ+RSI+SIG v8: SOLO para backtest en el Strategy Tester.
// Misma logica de senales A / B / C / D (D = divergencia del momentum del SQZ), pero con ordenes de verdad:
// entrada al cierre de la vela de la senal, stop intravela (strategy.exit) y salida al cierre bajo/sobre
// la EMA rapida (o invalidacion de B). Cada senal y cada lado se pueden prender/apagar por separado.
strategy("SQZ+RSI A+B+C+D Backtest UNIFICADO", shorttitle="SQZ+RSI BT AUTO", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, commission_type=strategy.commission.percent, commission_value=0.05)
 
// ===== Que probar =====
useMine = input.bool(false, "Que probar: usar mis casillas (en vez del preset)", group="Que probar", tooltip="Apagado: las casillas de Que probar siguen al preset de la temporalidad. Prendido: valen las que tildes abajo, para aislar senales o lados.")
m_useA   = input.bool(true, "Senal A (pullback)", group="Que probar")
m_useB   = input.bool(true, "Senal B (ruptura de squeeze)", group="Que probar")
m_useC   = input.bool(true, "Senal C (reversion)", group="Que probar")
m_aLong  = input.bool(true, "A: COMPRAS", group="Que probar")
m_aShort = input.bool(true, "A: VENTAS", group="Que probar")
m_bLong  = input.bool(true, "B: COMPRAS", group="Que probar")
m_bShort = input.bool(true, "B: VENTAS", group="Que probar")
m_cLong  = input.bool(false, "C: COMPRAS (piso) - apagada por defecto", group="Que probar")
m_cShort = input.bool(true, "C: VENTAS (techo)", group="Que probar")
m_useD   = input.bool(true, "Senal D (divergencia del momentum)", group="Que probar")
m_dLong  = input.bool(true, "D: COMPRAS (divergencia alcista)", group="Que probar")
m_dShort = input.bool(true, "D: VENTAS (divergencia bajista)", group="Que probar")
 
// ===== Riesgo del backtest =====
riskPct = input.float(1.0, "Riesgo por trade (% del capital)", minval=0.1, step=0.1, group="Backtest", tooltip="El tamano de cada posicion se calcula para que, si toca el stop, se pierda este porcentaje del capital (1R). Asi las ganancias y perdidas se leen en R. La comision se edita en la pestana Propiedades (por defecto 0.05% por lado).")
maxLev  = input.float(1.0, "Apalancamiento maximo (x capital)", minval=0.1, step=0.5, group="Backtest")
 
// ===== Inputs: Squeeze =====
m_bbLen        = input.int(20, "BB Length", minval=1, group="Squeeze")
m_bbMult       = input.float(2.0, "BB Mult", step=0.5, group="Squeeze")
m_kcLen        = input.int(20, "KC Length", minval=1, group="Squeeze")
m_kcMult       = input.float(1.5, "KC Mult", step=0.5, group="Squeeze")
m_useTrueRange = input.bool(true, "Usar True Range en KC", group="Squeeze")
 
// ===== Inputs: RSI =====
m_rsiLen = input.int(14, "RSI Length", minval=1, group="RSI")
rsiSrc = input.source(close, "RSI Source", group="RSI")
m_maType = input.string("SMA", "Tipo de media del RSI", options=["SMA", "EMA", "WMA", "RMA"], group="RSI")
m_maLen  = input.int(14, "Largo de la media del RSI", minval=1, group="RSI")
 
// ===== Inputs: Base y senal A =====
m_emaFLen    = input.int(20, "EMA rapida", minval=1, group="Senal A y base")
m_emaMLen    = input.int(55, "EMA media", minval=1, group="Senal A y base")
m_emaSLen    = input.int(200, "EMA lenta", minval=1, group="Senal A y base")
m_adxLen     = input.int(14, "ADX Length", minval=1, group="Senal A y base")
m_adxMin     = input.float(20.0, "ADX minimo", minval=1, group="Senal A y base")
m_pbBars     = input.int(5, "Velas para buscar el pullback", minval=1, group="Senal A y base")
m_atrLen     = input.int(14, "ATR Length", minval=1, group="Senal A y base")
m_atrMult    = input.float(0.25, "Margen del stop de A (x ATR)", minval=0, step=0.05, group="Senal A y base")
m_useRsiF    = input.bool(true, "A: exigir RSI por encima/debajo de su media", group="Senal A y base")
 
// ===== Inputs: Senal B =====
m_minSqz    = input.int(6, "Velas minimas de squeeze activo", minval=2, group="Senal B (squeeze)")
m_graceBars = input.int(2, "Velas de gracia tras liberarse el squeeze", minval=0, group="Senal B (squeeze)")
m_needMom   = input.bool(true, "Exigir momentum a favor y creciente", group="Senal B (squeeze)")
m_needE200  = input.bool(true, "Exigir precio del lado correcto de la EMA lenta", group="Senal B (squeeze)")
m_stopModeB = input.string("Punto medio del rango", "Stop de B", options=["Punto medio del rango", "Lado opuesto del rango"], group="Senal B (squeeze)")
m_invBars   = input.int(3, "Velas de invalidacion (0 = apagado)", minval=0, group="Senal B (squeeze)")
 
// ===== Inputs: Senal C =====
m_cHot       = input.float(65.0, "RSI debe haber llegado a (techo, venta)", minval=50, maxval=100, group="Senal C (reversion)")
m_cCold      = input.float(35.0, "RSI debe haber bajado a (piso, compra)", minval=0, maxval=50, group="Senal C (reversion)")
m_cLook      = input.int(10, "Velas hacia atras para buscar ese nivel del RSI", minval=2, group="Senal C (reversion)")
m_cWin       = input.int(3, "Velas de espera tras el cruce del RSI para confirmar", minval=0, group="Senal C (reversion)")
m_cNeedMom   = input.bool(true, "Exigir momentum cayendo (venta) / subiendo (compra)", group="Senal C (reversion)")
m_cNeedEma   = input.bool(true, "Exigir cierre bajo (venta) / sobre (compra) la EMA rapida", group="Senal C (reversion)")
m_cStopBars  = input.int(7, "Velas para ubicar el extremo del stop", minval=2, group="Senal C (reversion)")
m_cAtrMult   = input.float(0.25, "Margen del stop de C (x ATR)", minval=0, step=0.05, group="Senal C (reversion)")
m_cMaxRisk   = input.float(3.0, "Descartar si el stop queda a mas de X ATR (0 = apagado)", minval=0, step=0.5, group="Senal C (reversion)")
 
// ===== Inputs: Senal D (divergencias del momentum) =====
m_dvL       = input.int(5, "Velas a la izquierda del pivote", minval=1, group="Senal D (divergencia)")
m_dvR       = input.int(5, "Velas a la derecha del pivote (= retraso de la senal)", minval=1, group="Senal D (divergencia)")
m_dvMin     = input.int(5, "Distancia minima entre pivotes (velas)", minval=1, group="Senal D (divergencia)")
m_dvMax     = input.int(60, "Distancia maxima entre pivotes (velas)", minval=5, group="Senal D (divergencia)")
m_dvZero    = input.bool(true, "Exigir pivotes del lado correcto del cero (alcista: bajo 0, bajista: sobre 0)", group="Senal D (divergencia)")
m_dNeedEma  = input.bool(true, "Exigir cierre sobre (compra) / bajo (venta) la EMA rapida al confirmarse", group="Senal D (divergencia)")
m_dAtrMult  = input.float(0.25, "Margen del stop de D (x ATR) tras el pivote", minval=0, step=0.05, group="Senal D (divergencia)")
m_dMaxRisk  = input.float(0.0, "Descartar si el stop queda a mas de X ATR (0 = apagado)", minval=0, step=0.5, group="Senal D (divergencia)")
 
// ===== Inputs: Volumen (opcional) =====
m_useVol  = input.bool(false, "Exigir volumen alto en la vela de la senal (A y B)", group="Volumen (opcional)")
m_volLen  = input.int(20, "Media de volumen (velas)", minval=1, group="Volumen (opcional)")
m_volMult = input.float(1.5, "Multiplo minimo sobre la media", minval=0.1, step=0.1, group="Volumen (opcional)")
 
// ===== Presets por temporalidad (GENERADO por src/sqzlab/genpine.py desde params/*.json; NO editar a mano) =====
// Un set por temporalidad, nunca por moneda. Auto: <1d -> H4, 1d a <1w -> D1, >=1w -> W1. Solo 4h, 1D y 1W estan calibrados.
// Los parametros optimizables siguen al preset. Las casillas de Que probar siguen al preset solo si NO tildas
// 'usar mis casillas'. Riesgo por trade y apalancamiento maximo son siempre tuyos (el preset no los toca).
// Manual = todo sale de los campos de las pestanas de arriba (sus defaults son los de D1).
presetSel = input.string("Auto (por temporalidad)", "Preset", options=["Auto (por temporalidad)", "H4", "D1", "W1", "Manual"], group="Preset")
tfSec    = timeframe.in_seconds()
autoIdx  = tfSec < 86400 ? 1 : tfSec < 604800 ? 2 : 3
presetIdx = presetSel == "H4" ? 1 : presetSel == "D1" ? 2 : presetSel == "W1" ? 3 : presetSel == "Manual" ? 0 : autoIdx

useA = (useMine or presetIdx == 0) ? m_useA : presetIdx == 1 ? true : presetIdx == 2 ? true : true
useB = (useMine or presetIdx == 0) ? m_useB : presetIdx == 1 ? true : presetIdx == 2 ? true : true
useC = (useMine or presetIdx == 0) ? m_useC : presetIdx == 1 ? true : presetIdx == 2 ? true : true
aLong = (useMine or presetIdx == 0) ? m_aLong : presetIdx == 1 ? true : presetIdx == 2 ? true : true
aShort = (useMine or presetIdx == 0) ? m_aShort : presetIdx == 1 ? true : presetIdx == 2 ? true : true
bLong = (useMine or presetIdx == 0) ? m_bLong : presetIdx == 1 ? true : presetIdx == 2 ? true : true
bShort = (useMine or presetIdx == 0) ? m_bShort : presetIdx == 1 ? true : presetIdx == 2 ? true : true
cLong = (useMine or presetIdx == 0) ? m_cLong : presetIdx == 1 ? false : presetIdx == 2 ? false : false
cShort = (useMine or presetIdx == 0) ? m_cShort : presetIdx == 1 ? true : presetIdx == 2 ? true : true
useD = (useMine or presetIdx == 0) ? m_useD : presetIdx == 1 ? true : presetIdx == 2 ? true : true
dLong = (useMine or presetIdx == 0) ? m_dLong : presetIdx == 1 ? true : presetIdx == 2 ? true : true
dShort = (useMine or presetIdx == 0) ? m_dShort : presetIdx == 1 ? true : presetIdx == 2 ? true : true
bbLen = presetIdx == 0 ? m_bbLen : presetIdx == 1 ? 20 : presetIdx == 2 ? 20 : 20
bbMult = presetIdx == 0 ? m_bbMult : presetIdx == 1 ? 2.0 : presetIdx == 2 ? 2.0 : 2.0
kcLen = presetIdx == 0 ? m_kcLen : presetIdx == 1 ? 20 : presetIdx == 2 ? 20 : 20
kcMult = presetIdx == 0 ? m_kcMult : presetIdx == 1 ? 1.5 : presetIdx == 2 ? 1.5 : 1.5
useTrueRange = presetIdx == 0 ? m_useTrueRange : presetIdx == 1 ? true : presetIdx == 2 ? true : true
rsiLen = presetIdx == 0 ? m_rsiLen : presetIdx == 1 ? 14 : presetIdx == 2 ? 14 : 14
maType = presetIdx == 0 ? m_maType : presetIdx == 1 ? "SMA" : presetIdx == 2 ? "SMA" : "SMA"
maLen = presetIdx == 0 ? m_maLen : presetIdx == 1 ? 14 : presetIdx == 2 ? 14 : 14
emaFLen = presetIdx == 0 ? m_emaFLen : presetIdx == 1 ? 20 : presetIdx == 2 ? 20 : 20
emaMLen = presetIdx == 0 ? m_emaMLen : presetIdx == 1 ? 55 : presetIdx == 2 ? 55 : 55
emaSLen = presetIdx == 0 ? m_emaSLen : presetIdx == 1 ? 200 : presetIdx == 2 ? 200 : 200
adxLen = presetIdx == 0 ? m_adxLen : presetIdx == 1 ? 14 : presetIdx == 2 ? 14 : 14
adxMin = presetIdx == 0 ? m_adxMin : presetIdx == 1 ? 20.0 : presetIdx == 2 ? 20.0 : 20.0
pbBars = presetIdx == 0 ? m_pbBars : presetIdx == 1 ? 5 : presetIdx == 2 ? 5 : 5
atrLen = presetIdx == 0 ? m_atrLen : presetIdx == 1 ? 14 : presetIdx == 2 ? 14 : 14
atrMult = presetIdx == 0 ? m_atrMult : presetIdx == 1 ? 0.25 : presetIdx == 2 ? 0.25 : 0.25
useRsiF = presetIdx == 0 ? m_useRsiF : presetIdx == 1 ? true : presetIdx == 2 ? true : true
minSqz = presetIdx == 0 ? m_minSqz : presetIdx == 1 ? 6 : presetIdx == 2 ? 6 : 6
graceBars = presetIdx == 0 ? m_graceBars : presetIdx == 1 ? 2 : presetIdx == 2 ? 2 : 2
needMom = presetIdx == 0 ? m_needMom : presetIdx == 1 ? true : presetIdx == 2 ? true : true
needE200 = presetIdx == 0 ? m_needE200 : presetIdx == 1 ? true : presetIdx == 2 ? true : true
stopModeB = presetIdx == 0 ? m_stopModeB : presetIdx == 1 ? "Punto medio del rango" : presetIdx == 2 ? "Punto medio del rango" : "Punto medio del rango"
invBars = presetIdx == 0 ? m_invBars : presetIdx == 1 ? 3 : presetIdx == 2 ? 3 : 3
cHot = presetIdx == 0 ? m_cHot : presetIdx == 1 ? 65.0 : presetIdx == 2 ? 65.0 : 65.0
cCold = presetIdx == 0 ? m_cCold : presetIdx == 1 ? 35.0 : presetIdx == 2 ? 35.0 : 35.0
cLook = presetIdx == 0 ? m_cLook : presetIdx == 1 ? 10 : presetIdx == 2 ? 10 : 10
cWin = presetIdx == 0 ? m_cWin : presetIdx == 1 ? 3 : presetIdx == 2 ? 3 : 3
cNeedMom = presetIdx == 0 ? m_cNeedMom : presetIdx == 1 ? true : presetIdx == 2 ? true : true
cNeedEma = presetIdx == 0 ? m_cNeedEma : presetIdx == 1 ? true : presetIdx == 2 ? true : true
cStopBars = presetIdx == 0 ? m_cStopBars : presetIdx == 1 ? 7 : presetIdx == 2 ? 7 : 7
cAtrMult = presetIdx == 0 ? m_cAtrMult : presetIdx == 1 ? 0.25 : presetIdx == 2 ? 0.25 : 0.25
cMaxRisk = presetIdx == 0 ? m_cMaxRisk : presetIdx == 1 ? 3.0 : presetIdx == 2 ? 3.0 : 3.0
dvL = presetIdx == 0 ? m_dvL : presetIdx == 1 ? 5 : presetIdx == 2 ? 5 : 5
dvR = presetIdx == 0 ? m_dvR : presetIdx == 1 ? 5 : presetIdx == 2 ? 5 : 5
dvMin = presetIdx == 0 ? m_dvMin : presetIdx == 1 ? 5 : presetIdx == 2 ? 5 : 5
dvMax = presetIdx == 0 ? m_dvMax : presetIdx == 1 ? 60 : presetIdx == 2 ? 60 : 60
dvZero = presetIdx == 0 ? m_dvZero : presetIdx == 1 ? true : presetIdx == 2 ? true : true
dNeedEma = presetIdx == 0 ? m_dNeedEma : presetIdx == 1 ? true : presetIdx == 2 ? true : true
dAtrMult = presetIdx == 0 ? m_dAtrMult : presetIdx == 1 ? 0.25 : presetIdx == 2 ? 0.25 : 0.25
dMaxRisk = presetIdx == 0 ? m_dMaxRisk : presetIdx == 1 ? 0.0 : presetIdx == 2 ? 0.0 : 0.0
useVol = presetIdx == 0 ? m_useVol : presetIdx == 1 ? false : presetIdx == 2 ? false : false
volLen = presetIdx == 0 ? m_volLen : presetIdx == 1 ? 20 : presetIdx == 2 ? 20 : 20
volMult = presetIdx == 0 ? m_volMult : presetIdx == 1 ? 1.5 : presetIdx == 2 ? 1.5 : 1.5

// ===== Squeeze y momentum =====
src     = close
basis   = ta.sma(src, bbLen)
dev     = bbMult * ta.stdev(src, bbLen)
upperBB = basis + dev
lowerBB = basis - dev
kcMa    = ta.sma(src, kcLen)
rng     = useTrueRange ? ta.tr : (high - low)
rngMa   = ta.sma(rng, kcLen)
upperKC = kcMa + rngMa * kcMult
lowerKC = kcMa - rngMa * kcMult
sqzOn   = lowerBB > lowerKC and upperBB < upperKC
 
avgHL = math.avg(ta.highest(high, kcLen), ta.lowest(low, kcLen))
mom   = ta.linreg(src - math.avg(avgHL, ta.sma(close, kcLen)), kcLen, 0)
 
// ===== RSI y su media =====
rsiVal = ta.rsi(rsiSrc, rsiLen)
rsiMa  = maType == "EMA" ? ta.ema(rsiVal, maLen) : maType == "WMA" ? ta.wma(rsiVal, maLen) : maType == "RMA" ? ta.rma(rsiVal, maLen) : ta.sma(rsiVal, maLen)
 
// ===== Base comun =====
ema1 = ta.ema(close, emaFLen)
ema2 = ta.ema(close, emaMLen)
ema3 = ta.ema(close, emaSLen)
[diP, diM, adxVal] = ta.dmi(adxLen, adxLen)
atrVal = ta.atr(atrLen)
 
hasVol = ta.cum(nz(volume)) > 0
volAvg = ta.sma(volume, volLen)
volOk  = not useVol or not hasVol or volume > volAvg * volMult
 
// ===== Posicion real del strategy (ya refleja los stops tocados dentro de la vela) =====
posNow = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
 
var int posType   = 0
var float stopLvl = na
var int entryBar  = na
var float entHi   = na
var float entLo   = na
 
// ===== Senal A: pullback a las EMAs en tendencia =====
upTrend   = ema1 > ema2 and ema2 > ema3
downTrend = ema1 < ema2 and ema2 < ema3
adxOk     = adxVal >= adxMin and adxVal > nz(adxVal[1])
 
touchUp = low <= ema1 ? 1.0 : 0.0
breakUp = close < ema2 ? 1.0 : 0.0
touchDn = high >= ema1 ? 1.0 : 0.0
breakDn = close > ema2 ? 1.0 : 0.0
setupLong  = ta.highest(touchUp, pbBars) == 1 and ta.highest(breakUp, pbBars) == 0
setupShort = ta.highest(touchDn, pbBars) == 1 and ta.highest(breakDn, pbBars) == 0
pbLow  = ta.lowest(low, pbBars)
pbHigh = ta.highest(high, pbBars)
 
trigLong  = close > ema1 and close > high[1]
trigShort = close < ema1 and close < low[1]
rsiLongOk  = not useRsiF or rsiVal > rsiMa
rsiShortOk = not useRsiF or rsiVal < rsiMa
 
longRawA  = useA and aLong and upTrend and adxOk and setupLong and trigLong and rsiLongOk and volOk
shortRawA = useA and aShort and downTrend and adxOk and setupShort and trigShort and rsiShortOk and volOk
 
var int lastLong  = na
var int lastShort = na
longSigA  = false
shortSigA = false
if longRawA and (na(lastLong) or bar_index - lastLong > pbBars)
    longSigA := true
    lastLong := bar_index
if shortRawA and (na(lastShort) or bar_index - lastShort > pbBars)
    shortSigA := true
    lastShort := bar_index
 
// ===== Senal B: ruptura de squeeze =====
var int runLen   = 0
var int sinceOn  = 999
var float sqHi   = na
var float sqLo   = na
 
rHiPrev   = sqHi
rLoPrev   = sqLo
armedPrev = runLen >= minSqz and sinceOn <= graceBars
 
momUp   = mom > 0 and mom > nz(mom[1])
momDown = mom < 0 and mom < nz(mom[1])
 
longSigB  = useB and bLong and armedPrev and close > rHiPrev and (not needE200 or close > ema3) and (not needMom or momUp) and volOk
shortSigB = useB and bShort and armedPrev and close < rLoPrev and (not needE200 or close < ema3) and (not needMom or momDown) and volOk
 
if sqzOn
    if sinceOn > 0
        runLen := 1
        sqHi := high
        sqLo := low
    else
        runLen := runLen + 1
        sqHi := math.max(nz(sqHi, high), high)
        sqLo := math.min(nz(sqLo, low), low)
    sinceOn := 0
else
    sinceOn := math.min(sinceOn + 1, 999)
 
if longSigB or shortSigB
    runLen := 0
    sinceOn := 999
 
// ===== Senal C: reversion en techo / piso =====
rsiHotRecent  = ta.highest(rsiVal, cLook) >= cHot
rsiColdRecent = ta.lowest(rsiVal, cLook) <= cCold
rsiXDown      = ta.crossunder(rsiVal, rsiMa)
rsiXUp        = ta.crossover(rsiVal, rsiMa)
 
var int cArmS = na
var int cArmL = na
if rsiXDown and rsiHotRecent
    cArmS := bar_index
if rsiXUp and rsiColdRecent
    cArmL := bar_index
 
stopCS  = ta.highest(high, cStopBars) + cAtrMult * atrVal
stopCL  = ta.lowest(low, cStopBars) - cAtrMult * atrVal
riskOkS = cMaxRisk == 0 or stopCS - close <= cMaxRisk * atrVal
riskOkL = cMaxRisk == 0 or close - stopCL <= cMaxRisk * atrVal
 
shortSigC = useC and cShort and bar_index - nz(cArmS, -999) <= cWin and rsiVal < rsiMa and (not cNeedMom or mom < nz(mom[1])) and (not cNeedEma or close < ema1) and riskOkS and posNow != -1
longSigC  = useC and cLong and bar_index - nz(cArmL, -999) <= cWin and rsiVal > rsiMa and (not cNeedMom or mom > nz(mom[1])) and (not cNeedEma or close > ema1) and riskOkL and posNow != 1
 
if shortSigC
    cArmS := na
if longSigC
    cArmL := na
 
// ===== Senal D: divergencia del momentum del SQZ (misma deteccion que el indicador, sin dibujo) =====
pivL = ta.pivotlow(mom, dvL, dvR)
pivH = ta.pivothigh(mom, dvL, dvR)
 
var int   pLBar = na
var float pLPx  = na
var float pLMom = na
var int   pHBar = na
var float pHPx  = na
var float pHMom = na
 
bullDiv = false
bearDiv = false
 
if not na(pivL)
    nBar    = bar_index - dvR
    nPx     = low[dvR]
    okRange = not na(pLBar) and nBar - pLBar >= dvMin and nBar - pLBar <= dvMax
    okSide  = not dvZero or (pivL < 0 and nz(pLMom) < 0)
    if okRange and okSide
        if nPx < pLPx and pivL > pLMom
            bullDiv := true
    pLBar := nBar
    pLPx  := nPx
    pLMom := pivL
 
if not na(pivH)
    nBarH    = bar_index - dvR
    nPxH     = high[dvR]
    okRangeH = not na(pHBar) and nBarH - pHBar >= dvMin and nBarH - pHBar <= dvMax
    okSideH  = not dvZero or (pivH > 0 and nz(pHMom) > 0)
    if okRangeH and okSideH
        if nPxH > pHPx and pivH < pHMom
            bearDiv := true
    pHBar := nBarH
    pHPx  := nPxH
    pHMom := pivH
 
stopDL   = pLPx - dAtrMult * atrVal
stopDS   = pHPx + dAtrMult * atrVal
riskOkDL = dMaxRisk == 0 or close - stopDL <= dMaxRisk * atrVal
riskOkDS = dMaxRisk == 0 or stopDS - close <= dMaxRisk * atrVal
longSigD  = useD and dLong and bullDiv and close > stopDL and (not dNeedEma or close > ema1) and riskOkDL and posNow != 1
shortSigD = useD and dShort and bearDiv and close < stopDS and (not dNeedEma or close < ema1) and riskOkDS and posNow != -1
 
// ===== Tamano de la posicion: arriesga riskPct del capital hasta el stop =====
calcQty(float stopPx) =>
    riskPU = math.abs(close - stopPx)
    qRisk = riskPU > 0 ? (strategy.equity * riskPct / 100) / riskPU : 0.0
    math.min(qRisk, strategy.equity * maxLev / close)
 
// ===== Salidas por condicion (el stop lo maneja strategy.exit, dentro de la vela) =====
exitLongCond  = posNow == 1 and (close < ema1 or (posType == 2 and bar_index - nz(entryBar, -999) <= invBars and close < entHi))
exitShortCond = posNow == -1 and (close > ema1 or (posType == 2 and bar_index - nz(entryBar, -999) <= invBars and close > entLo))
 
if exitLongCond
    strategy.close("L", comment="Salida EMA/inval.")
if exitShortCond
    strategy.close("S", comment="Salida EMA/inval.")
 
// ===== Entradas (prioridad B, A, C; una senal del mismo lado de la posicion abierta se ignora) =====
entL = false
entS = false
float q = na
 
if longSigB
    if posNow != 1
        stopB = stopModeB == "Punto medio del rango" ? (rHiPrev + rLoPrev) / 2 : rLoPrev
        q := calcQty(stopB)
        if q > 0
            entL := true
            posType := 2
            entryBar := bar_index
            entHi := rHiPrev
            entLo := rLoPrev
            stopLvl := stopB
            strategy.entry("L", strategy.long, qty=q, comment="B")
            strategy.exit("xL", from_entry="L", stop=stopB)
else if shortSigB
    if posNow != -1
        stopB = stopModeB == "Punto medio del rango" ? (rHiPrev + rLoPrev) / 2 : rHiPrev
        q := calcQty(stopB)
        if q > 0
            entS := true
            posType := 2
            entryBar := bar_index
            entHi := rHiPrev
            entLo := rLoPrev
            stopLvl := stopB
            strategy.entry("S", strategy.short, qty=q, comment="B")
            strategy.exit("xS", from_entry="S", stop=stopB)
else if longSigA
    if posNow != 1
        stopA = pbLow - atrMult * atrVal
        q := calcQty(stopA)
        if q > 0
            entL := true
            posType := 1
            stopLvl := stopA
            strategy.entry("L", strategy.long, qty=q, comment="A")
            strategy.exit("xL", from_entry="L", stop=stopA)
else if shortSigA
    if posNow != -1
        stopA = pbHigh + atrMult * atrVal
        q := calcQty(stopA)
        if q > 0
            entS := true
            posType := 1
            stopLvl := stopA
            strategy.entry("S", strategy.short, qty=q, comment="A")
            strategy.exit("xS", from_entry="S", stop=stopA)
else if longSigC
    q := calcQty(stopCL)
    if q > 0
        entL := true
        posType := 3
        stopLvl := stopCL
        strategy.entry("L", strategy.long, qty=q, comment="C")
        strategy.exit("xL", from_entry="L", stop=stopCL)
else if shortSigC
    q := calcQty(stopCS)
    if q > 0
        entS := true
        posType := 3
        stopLvl := stopCS
        strategy.entry("S", strategy.short, qty=q, comment="C")
        strategy.exit("xS", from_entry="S", stop=stopCS)
else if longSigD
    q := calcQty(stopDL)
    if q > 0
        entL := true
        posType := 4
        stopLvl := stopDL
        strategy.entry("L", strategy.long, qty=q, comment="D")
        strategy.exit("xL", from_entry="L", stop=stopDL)
else if shortSigD
    q := calcQty(stopDS)
    if q > 0
        entS := true
        posType := 4
        stopLvl := stopDS
        strategy.entry("S", strategy.short, qty=q, comment="D")
        strategy.exit("xS", from_entry="S", stop=stopDS)
 
// ===== Marcas en el grafico: A = triangulos, B = rombos, C = flechas azules, D = cuadrados amarillos =====
plotshape(entL and posType == 4, "Compra D", style=shape.square, location=location.belowbar, color=color.yellow, size=size.small)
plotshape(entS and posType == 4, "Venta D", style=shape.square, location=location.abovebar, color=color.yellow, size=size.small)
plotshape(entL and posType == 1, "Compra A", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(entS and posType == 1, "Venta A", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
plotshape(entL and posType == 2, "Compra B", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.small)
plotshape(entS and posType == 2, "Venta B", style=shape.diamond, location=location.abovebar, color=color.fuchsia, size=size.small)
plotshape(entL and posType == 3, "Compra C", style=shape.arrowup, location=location.belowbar, color=color.new(#2962FF, 0), size=size.normal)
plotshape(entS and posType == 3, "Venta C", style=shape.arrowdown, location=location.abovebar, color=color.new(#2962FF, 0), size=size.normal)
plot(ema1, "EMA rapida (salida)", color=color.new(color.aqua, 60))

// ===== Cartel con el preset en uso =====
presetName = presetIdx == 0 ? "Manual" : presetIdx == 1 ? "H4" : presetIdx == 2 ? "D1" : "W1"
tfCalibrated = tfSec == 14400 or tfSec == 86400 or tfSec == 604800
var table infoTbl = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(infoTbl, 0, 0, "Preset: " + presetName + (useMine ? " | casillas propias" : "") + (presetIdx == 0 or tfCalibrated ? "" : " (TF no calibrado)"), text_color=color.white, bgcolor=color.new(color.gray, 30))
